# ---------------------------------------------------------------------------------------------
# GapLearning configuration. Copy this file to `.env` in the repository root:
#   cp .env.example .env
# Vite reads the VITE_* variables; the API server loads the rest when it starts. Variables
# already set in your shell (or in your host's settings) take precedence over the file.
# Everything is optional: with nothing set, the app works fully, just without AI features.
# ---------------------------------------------------------------------------------------------

# ---- Frontend (read by Vite at build time; must start with VITE_) ----------------------------
# Base URL of the API. Defaults to `/api` (same origin). Set it when the frontend and API are
# deployed separately, e.g. frontend on Vercel and API on Render.
# VITE_API_BASE_URL=https://gaplearning-api.example.com/api

# Where the Vite dev server proxies /api during `npm run dev`.
# API_PROXY_TARGET=http://localhost:8787

# ---- API server ------------------------------------------------------------------------------
# Port for the API (default 8787; macOS reserves 5000 for AirPlay).
# PORT=8787

# Enables AI features (tutor, explanations, question generation). The key never leaves the server.
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=30000

# Per-IP limit on AI requests (default: 30 per 10 minutes).
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=600000

# Enables POST/PUT/DELETE /api/questions for maintaining the curated bank. Send it as
# `Authorization: Bearer <token>`. Leave unset to keep the bank read-only.
# ADMIN_TOKEN=

# Where admin edits to the question bank are stored (default: server/data).
# DATA_DIR=

# Comma-separated origins allowed to call the API cross-origin. Not needed when the API serves
# the frontend itself or sits behind the Vite proxy.
# CORS_ORIGIN=https://gaplearning.vercel.app

# Number of reverse proxies in front of the API (for correct client IPs in rate limiting).
# TRUST_PROXY=1

# Path to the built frontend the API should serve (default: ./dist). Set to `false` to disable.
# CLIENT_DIST=
